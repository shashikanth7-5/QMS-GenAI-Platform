# Copy to env.yaml locally, fill values, and do not commit env.yaml.
FLASK_ENV: "production"
MOCK_MODE: "false"
SECRET_KEY: "replace-with-64-plus-random-characters"

# Cloud Run runtime/storage. Prefer Cloud SQL Postgres for production.
QMS_DATA_DIR: "/app/data"
DATABASE_URL: "sqlite:////app/data/qms_data.db"
UPLOAD_STORAGE_BACKEND: "local"
UPLOAD_STORAGE_DIR: "/app/data/uploads"
CHROMA_DB_DIR: "/app/data/chroma_db"

# Live LLM provider. Reuse values from Render.
AI_PROVIDER: "groq"
AI_FAILOVER_PROVIDERS: "openai,gemini,anthropic"
AI_GROQ_MODEL: "openai/gpt-oss-120b"
AI_OPENAI_MODEL: "gpt-4o-mini"
AI_GEMINI_MODEL: "gemini-1.5-flash"
AI_ANTHROPIC_MODEL: "claude-3-5-sonnet-latest"
LLM_MAX_OUTPUT_TOKENS: "10000"
LLM_TIMEOUT_SECONDS: "60"
LLM_MAX_RETRIES: "2"

# Salesforce sandbox tenant.
BOOTSTRAP_SF_TENANT: "true"
SF_TENANT_ID: "sf-sandbox"
SF_TENANT_DISPLAY: "Salesforce Sandbox"
SF_ORIGIN: "https://orgfarm-8fbe692a55-dev-ed.develop.my.salesforce.com"
CORS_ORIGINS: "https://orgfarm-8fbe692a55-dev-ed.develop.my.salesforce.com"

# Pilot/admin behavior.
SEED_BUILTIN_USERS: "true"
SESSION_COOKIE_SECURE: "true"
SESSION_COOKIE_SAMESITE: "Lax"
LOG_FORMAT: "json"
LOG_LEVEL: "INFO"
WEB_CONCURRENCY: "1"
WEB_THREADS: "4"
WEB_TIMEOUT: "180"
