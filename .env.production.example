FLASK_ENV=production
SECRET_KEY=replace-with-64-plus-random-characters
API_V1_KEY=replace-with-strong-integration-key

DATABASE_URL=postgresql+psycopg2://qms:replace-password@postgres:5432/qms
CELERY_BROKER_URL=redis://redis:6379/0
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1

UPLOAD_STORAGE_BACKEND=local
UPLOAD_STORAGE_DIR=/app/uploads

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=qms-workflow@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
AGENT_ALERT_EMAIL=qms-admins@example.com

AGENT_SUPERVISOR_INTERVAL_SECONDS=1200
AGENT_SUPERVISOR_LIMIT=50
AGENT_SUPERVISOR_ALLOW_WEEKEND=false
AGENT_KILL_SWITCH=false

SEED_BUILTIN_USERS=false
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

MOCK_MODE=false
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=
AI_FAILOVER_PROVIDERS=openai,gemini,anthropic
AI_GROQ_API_KEY=
AI_GROQ_MODEL=openai/gpt-oss-120b
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-1.5-flash
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

LOG_FORMAT=json
